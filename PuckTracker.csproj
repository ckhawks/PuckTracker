<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaxMind.GeoIP2" Version="5.4.1" />
    <PackageReference Include="Npgsql" Version="10.0.2" />
    <PackageReference Include="SocketIOClient" Version="3.1.1" />
    <PackageReference Include="SteamKit2" Version="3.4.0" />
  </ItemGroup>

  <!--
    The GeoIP databases are gitignored (76 MB) and live on the deploy target, so a fresh
    clone does not have them. Copy them only when present: EnrichWithGeoIP already treats
    a missing database as "no location data" rather than an error, and the deploy excludes
    the .mmdb files anyway.
  -->
  <ItemGroup>
    <None Include="GeoLite2-City.mmdb" CopyToOutputDirectory="PreserveNewest" Condition="Exists('GeoLite2-City.mmdb')" />
    <None Include="GeoLite2-ASN.mmdb" CopyToOutputDirectory="PreserveNewest" Condition="Exists('GeoLite2-ASN.mmdb')" />
  </ItemGroup>

</Project>
